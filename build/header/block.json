{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "agart-blocks/ag-art-header",
  "version": "0.1.0",
  "title": "AG Art Header",
  "category": "theme",
  "icon": "smiley",
  "description": "Site Header.",
  "example": {},
  "attributes": {
    "className": {
      "type": "string",
      "default": "site-header"
    },
    "logo": {
      "type": "string",
      "default": "logo"
    },
    "hamburger": {
      "type": "string",
      "default": "house-hamburger"
    },
    "close": {
      "type": "string",
      "default": "house-close"
    }
  },
  "supports": {
    "html": false
  },
  "textdomain": "AG Art",
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}